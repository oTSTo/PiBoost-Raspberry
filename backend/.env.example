# Server
PORT=3000
BIND_HOST=0.0.0.0
BASE_PATH=/steamboost
DATA_DIR=/opt/piboost/data
SESSION_DAYS=90
MAX_ACCOUNTS=20

# Generata automaticamente da INSTALLA.sh. Non pubblicarla.
MASTER_KEY=GENERATA_AUTOMATICAMENTE

# Owner: SteamID64 di 17 cifre
OWNER_STEAM_ID64=7656119XXXXXXXXXX
OWNER_IDLE_MINUTES=30
OWNER_SESSION_HOURS=8

# Origini HTTPS autorizzate per le richieste owner, separate da virgola.
# Esempio: https://boost.example.com,https://raspberry.example.ts.net
OWNER_ALLOWED_ORIGINS=https://boost.example.com

# WebAuthn/passkey: hostname senza protocollo e origin HTTPS completa.
OWNER_RP_ID=boost.example.com
OWNER_RP_NAME=PiBoost Owner Admin
OWNER_PASSKEY_ORIGINS=https://boost.example.com
OWNER_PASSKEY_CHALLENGE_MINUTES=5

# Chi può incorporare PiBoost in un iframe. Consigliato: solo 'self'.
# Per più valori usa una virgola, per esempio: 'self',https://example.com
FRAME_ANCESTORS="'self'"
